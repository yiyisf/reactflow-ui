{
    "workflowId": "wf_loop_demo_001",
    "status": "COMPLETED",
    "startTime": 1704546000000,
    "endTime": 1704546120000,
    "input": {
        "maxRetries": 3,
        "dataItems": [
            "A",
            "B",
            "C"
        ]
    },
    "output": {
        "processedCount": 3,
        "status": "All items processed"
    },
    "workflowDefinition": {
        "name": "data_processing_loop",
        "description": "DO_WHILE 循环演示：逐项处理数据，循环 3 次",
        "version": 1,
        "tasks": [
            {
                "name": "fetch_data",
                "taskReferenceName": "fetch_data_ref",
                "type": "HTTP",
                "inputParameters": {
                    "uri": "https://api.example.com/data",
                    "method": "GET"
                }
            },
            {
                "name": "process_data_loop",
                "taskReferenceName": "loop_ref",
                "type": "DO_WHILE",
                "loopCondition": "${loop_ref.output.iteration} < ${workflow.input.maxRetries}",
                "loopOver": [
                    {
                        "name": "process_item",
                        "taskReferenceName": "process_item_ref",
                        "type": "SIMPLE",
                        "inputParameters": {
                            "item": "${fetch_data_ref.output.items[${loop_ref.output.iteration}]}"
                        }
                    },
                    {
                        "name": "validate_item",
                        "taskReferenceName": "validate_item_ref",
                        "type": "INLINE",
                        "inputParameters": {
                            "expression": "$.processedItem !== null"
                        }
                    }
                ]
            },
            {
                "name": "aggregate_results",
                "taskReferenceName": "aggregate_ref",
                "type": "JSON_JQ_TRANSFORM",
                "inputParameters": {
                    "queryExpression": ".items | length"
                }
            },
            {
                "name": "send_completion_event",
                "taskReferenceName": "completion_event_ref",
                "type": "EVENT",
                "inputParameters": {
                    "sink": "sqs:workflow-events"
                }
            }
        ],
        "schemaVersion": 2,
        "restartable": true
    },
    "tasks": [
        {
