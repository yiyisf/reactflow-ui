{
  "openapi": "3.0.3",
  "info": {
    "title": "CMDB 资产管理",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{env}.cmdb.example.com/api/{version}/",
      "variables": {
        "env": {
          "default": "test",
          "enum": [
            "test",
            "prod"
          ]
        },
        "version": {
          "default": "v1"
        }
      }
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/assets": {
      "get": {
        "operationId": "listAssets",
        "summary": "查询资产列表",
        "tags": [
          "资产"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "server",
                "network",
                "storage"
              ]
            },
            "description": "资产类型"
          },
          {
            "name": "keyword",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "名称关键字"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssetPage"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createAsset",
        "summary": "登记资产",
        "tags": [
          "资产"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssetCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Asset"
                }
              }
            }
          }
        }
      }
    },
    "/assets/{assetId}": {
      "parameters": [
        {
          "name": "assetId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          },
          "description": "资产 ID"
        }
      ],
      "get": {
        "operationId": "getAsset",
        "summary": "查询资产详情",
        "tags": [
          "资产"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Asset"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      },
      "delete": {
        "operationId": "deleteAsset",
        "summary": "下线资产",
        "tags": [
          "资产"
        ],
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/assets/{assetId}/relations": {
      "get": {
        "operationId": "listRelations",
        "summary": "查询资产关联关系",
        "tags": [
          "关系"
        ],
        "parameters": [
          {
            "name": "assetId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RelationNode"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "parameters": {
      "Page": {
        "name": "page",
        "in": "query",
        "schema": {
          "type": "integer",
          "default": 1,
          "minimum": 1
        },
        "description": "页码"
      }
    },
    "schemas": {
      "Asset": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "资产 ID",
            "example": "ast-001"
          },
          "name": {
            "type": "string",
            "title": "资产名称"
          },
          "type": {
            "type": "string",
            "enum": [
              "server",
              "network",
              "storage"
            ]
          },
          "owner": {
            "type": "string",
            "description": "负责人邮箱"
          },
          "status": {
            "type": "string",
            "enum": [
              "online",
              "offline"
            ],
            "example": "online"
          },
          "labels": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AssetCreate": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string",
            "title": "资产名称"
          },
          "type": {
            "type": "string",
            "enum": [
              "server",
              "network",
              "storage"
            ],
            "title": "资产类型"
          },
          "owner": {
            "type": "string",
            "description": "负责人邮箱"
          },
          "cpuCores": {
            "type": "integer",
            "default": 4
          },
          "managed": {
            "type": "boolean",
            "default": true
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "attributes": {
            "type": "object",
            "description": "扩展属性"
          }
        }
      },
      "AssetPage": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer",
            "description": "总数"
          },
          "page": {
            "type": "integer"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Asset"
            }
          }
        }
      },
      "RelationNode": {
        "type": "object",
        "properties": {
          "assetId": {
            "type": "string"
          },
          "relation": {
            "type": "string"
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RelationNode"
            }
          }
        }
      }
    }
  }
}
