{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:demo",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/app", "destination": "/app.html" },
    { "source": "/v1-0", "destination": "/v1-0.html" },
    { "source": "/v1-1", "destination": "/v1-1.html" }
  ]
}
