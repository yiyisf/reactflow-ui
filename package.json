{
  "name": "@yiyi_zhang/reactflow-ui",
  "version": "0.1.1",
  "description": "Conductor Workflow IDE — a visual workflow designer built with React 19, ReactFlow and Zustand for editing, validating and monitoring Netflix Conductor workflows.",
  "keywords": ["conductor", "workflow", "reactflow", "react", "visual-editor", "dag"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yiyisf/reactflow-ui.git"
  },
  "homepage": "https://github.com/yiyisf/reactflow-ui#readme",
  "bugs": {
    "url": "https://github.com/yiyisf/reactflow-ui/issues"
  },
  "type": "module",
  "main": "./dist/reactflow-ui.umd.js",
  "module": "./dist/reactflow-ui.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/reactflow-ui.es.js",
      "require": "./dist/reactflow-ui.umd.js"
    },
    "./style.css": "./dist/reactflow-ui.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "dagre": "^0.8.5",
    "lucide-react": "^0.562.0",
    "react-hotkeys-hook": "^5.2.1",
    "zundo": "^2.3.0",
    "zustand": "^5.0.9"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "reactflow": "^11.11.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/dagre": "^0.7.53",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "reactflow": "^11.11.4",
    "typescript": "^5.9.3",
    "vite": "^7.2.4"
  }
}